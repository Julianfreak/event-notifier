# ==========================================
# CONFIGURACIÓN DE ENTORNO - EVENT NOTIFIER
# ==========================================
# Instrucciones: Duplica este archivo, renómbralo a ".env" 
# y ajusta los valores según tu entorno local.

# --- Credenciales de RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# --- Configuración de Redis ---
REDIS_HOST=event_notifier_redis
REDIS_PORT=6379

# --- Configuración de RabbitMQ Host ---
RABBITMQ_HOST=event_notifier_rabbitmq
RABBITMQ_PORT=5672

# --- Puertos de la Aplicación ---
API_PORT=8081