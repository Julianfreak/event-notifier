// 1. Descubrir contenedores corriendo en Docker
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// 2. Filtrar y formatear las etiquetas del contenedor 'event_notifier_worker'
discovery.relabel "worker_logs" {
  targets = discovery.docker.containers.targets

  // Filtrar únicamente nuestro contenedor del worker
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/event_notifier_worker"
    action        = "keep"
  }

  // Mapear el nombre del contenedor (quitando el slash inicial) a la etiqueta 'container'
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
    replacement   = "$1"
  }
}

// 3. Recolectar los logs desde la salida estándar del contenedor descubierto
loki.source.docker "worker" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.worker_logs.output
  forward_to = [loki.write.local.receiver]
}

// 4. Enviar los logs recopilados hacia Loki
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}